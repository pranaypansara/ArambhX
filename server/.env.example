# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Example: postgresql://user:password@ep-cool-water-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Authentication (JWT Settings)
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# CORS allowed frontend origins (comma-separated). When unset, local
# development origins (http://localhost:5173, http://localhost:3000) are used.
CLIENT_ORIGINS="http://localhost:5173,http://localhost:3000"

# ML1 Prediction Service (Phase 6 integration)
# Base URL of the standalone FastAPI ML1 service (server/ml/service).
ML_SERVICE_URL=http://localhost:8000
# Timeout for ML service requests in milliseconds
ML_SERVICE_TIMEOUT_MS=10000

# Auth brute-force guard (express-rate-limit on /register and /login).
# In production the defaults are 20 requests / 15 minutes / IP; development
# defaults to 200 so the integration suite can rerun without lockouts.
AUTH_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
