# ML1 inference service configuration.
# All values are optional — sensible defaults are coded in app/config.py.

# Where the two required ML1 artifacts live (default: ./app/models)
ML_MODELS_DIR=./app/models

# Individual artifact overrides (defaults derived from ML_MODELS_DIR)
ML1_PIPELINE_PATH=./app/models/ml1_prediction_pipeline.pkl
ML1_THRESHOLD_PATH=./app/models/ml1_threshold.pkl

# development | production (controls --reload when run via python main.py)
APP_ENV=development

# Server host/port when run via `python main.py`
HOST=0.0.0.0
PORT=8000