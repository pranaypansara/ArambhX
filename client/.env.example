# Backend API base URL. Leave commented to use the Vite dev proxy (`/api` -> http://localhost:5000).
# For local development the proxy handles `/api` automatically, so you can leave this unset.
# VITE_API_BASE_URL=http://localhost:5000/api

# For production on Vercel, set this to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://arambhx-api.vercel.app/api

# Optional override for the Vite dev proxy target when the backend runs on another host/port.
# VITE_PROXY_TARGET=http://localhost:5000